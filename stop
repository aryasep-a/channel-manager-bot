#!/usr/bin/env bash
set -Eeuo pipefail
SESSION="${BOT_TMUX_SESSION:-channel-manager}"
if tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux send-keys -t "$SESSION" C-c
  sleep 2
  tmux kill-session -t "$SESSION" 2>/dev/null || true
  echo "Channel Manager dihentikan."
else
  echo "Session $SESSION tidak sedang berjalan."
fi
